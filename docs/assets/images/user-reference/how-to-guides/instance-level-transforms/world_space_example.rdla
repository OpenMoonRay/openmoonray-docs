SceneVariables {
    ["image width"] = 1000,
    ["image height"] = 300,
    ["pixel samples"] = 5,
    ["bsdf_samples"] = 6
}

env = EnvLight("/Scene/lighting/env") {
    ["on"] = true,
    ["intensity"] = 0.25,
    ["exposure"] = 0.0,
    ["texture"] = "/work/gshad/moonshine_test/rats_data/material/usd_preview_surface/gld_dusk_GI_HS_PF_hdr.exr",
}

PerspectiveCamera("/Scene/rendering/camera") {
    ["near"] = 0.01,
    ["node xform"] = rotate(-10, 1, 0, 0) * translate(0, 1, 0.5)
}

key = RectLight("/Scene/lighting/key") {
    ["node xform"] = translate(0, 0, 50) * rotate(-30, 1, 0, 0) * rotate(20, 0, 1, 0),
    ["intensity"] = 1,
    ["exposure"] = 1.0,
    ["color"] = Rgb(1,1,1),
    ["width"] = 1,
    ["height"] = 1,
    ["visible_in_camera"] = 1,
}

lightSet = LightSet("/Scene/lighting/lightSet") {
    --env,
    key,
}

shadowSet = ShadowSet("shadowSet") {
    --EnvLight("/Scene/lighting/env"),
    RectLight("/Scene/lighting/key")
}

--------------------------- Geometry --------------------------------------

spherePosX = (wedge * 1.2) - 0.6
planeGeom = MmGeometry("/Scene/geometry/planeGeom") {
    ["node xform"] = scale(100.0, 1, 100.0) * translate(-50, 0, 0),
    ["model"] = "/work/gshad/moonshine_test/rats_data/material/usd_preview_surface/plane_xz.mm",
}

axisGeom1 = MmGeometry("/Scene/geometry/axisGeom1") {
    ["node xform"] = scale(0.03, 0.7, 0.03) * rotate(90, 1, 0, 0) * translate(0, 0.015, -3.635),
    ["model"] = "/work/gshad/moonshine_test/rats_data/material/dwabase/thin_geometry_diffuse_transmission/primitives/box.mm"
}
axisGeom2 = MmGeometry("/Scene/geometry/axisGeom2") {
    ["node xform"] = scale(0.03, 0.7, 0.03) * rotate(90, 0, 0, 1) * translate(0.365, 0.015, -4),
    ["model"] = "/work/gshad/moonshine_test/rats_data/material/dwabase/thin_geometry_diffuse_transmission/primitives/box.mm"
}
axisGeom3 = MmGeometry("/Scene/geometry/axisGeom3") {
    ["node xform"] = scale(0.03, 0.7, 0.03) * translate(0, 0.35, -4),
    ["model"] = "/work/gshad/moonshine_test/rats_data/material/dwabase/thin_geometry_diffuse_transmission/primitives/box.mm"
}

sphereGeom = MmGeometry("/Scene/geometry/sphere") {
    ["node xform"] = scale(0.12, 0.12, 0.12) * translate(spherePosX, 0.65, -1.5),
    ["model"] = "/work/gshad/moonshine_test/rats_data/material/usd_preview_surface/sphere.mm"
}

GeometrySet("Scene/geometrySet") {
    planeGeom,
    axisGeom1,
    axisGeom2,
    axisGeom3,
    sphereGeom
}

--------------------------- Materials --------------------------------------

planeMap = ImageMap("/Scene/surfacing/planeMap") {
    ["texture"] = "/work/gshad/moonshine_test/rats_data/material/usd_preview_surface/rgb_checker.exr",
    ["scale"] = Vec2(100.0, 100.0),
    ["offset"] = Vec2(0.0, 0.0),
    ["wrap around"] = true,
}

desaturateMap = ColorCorrectSaturationMap("desaturateMap") {
    ["input"] = bind(planeMap),
    ["saturation"] = 0.0,
}

planeMtl = DwaBaseMaterial("/Scene/surfacing/planeMtl") {
    ["albedo"] = bind(desaturateMap),
    ["show_specular"] = false,
    ["presence"] = 0.75,
}

blueMtl = DwaBaseMaterial("/Scene/surfacing/blueMtl") {
    ["albedo"] = Rgb(0, 0, 1),
}

redMtl = DwaBaseMaterial("/Scene/surfacing/redMtl") {
    ["albedo"] = Rgb(1, 0, 0),
}

greenMtl = DwaBaseMaterial("/Scene/surfacing/greenMtl") {
    ["albedo"] = Rgb(0, 1, 0),
}

noiseMapColor = NoiseMap("noiseMapColor") {
    --["space"] = "object",
    --["object_space"] = leafAxisGeom,

    --["space"] = "input texture coordinates",
    --["input_texture_coordinates"] = bind(tsmLeaves),

    ["frequency_multiplier"] = 4,
    ["max_level"] = 5,
    ["use_smoothstep"] = true,
    ["smoothstep"] = Vec2(0.2, 0.8),
}

sphereMtl = DwaSolidDielectricMaterial("sphereMtl") {
    ["show_diffuse"] = true,
    ["albedo"] = bind(noiseMapColor, Rgb(0.0, 0.3, 0.64)),
    ["show_specular"] = false,
}

--------------------------- Materials end ---------------------------------

Layer("/Scene/layer") {
    {planeGeom, {""}, planeMtl, lightSet, undef(), undef()},
    {axisGeom1, {""}, blueMtl, lightSet, undef(), undef(), shadowSet},
    {axisGeom2, {""}, redMtl, lightSet, undef(), undef(), shadowSet},
    {axisGeom3, {""}, greenMtl, lightSet, undef(), undef(), shadowSet},
    {sphereGeom, {""}, sphereMtl, lightSet, undef(), undef()}
}
